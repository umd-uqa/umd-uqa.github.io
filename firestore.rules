rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the authenticated user's email exists in the admin_emails collection
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower()));
    }

    // Admin email whitelist collection
    match /admin_emails/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Videos collection for Resources page
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Events collection for Events page
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
